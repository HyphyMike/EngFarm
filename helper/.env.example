# Venice (or any OpenAI-compatible endpoint) for drafting
VENICE_API_KEY=
# X API keys from developer.x.com (app needs Read and Write permission)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Optional, only needed for "Find tweets" (search needs a paid/pay-per-use read tier)
X_BEARER_TOKEN=
# 1 = never call the X write API, just log what would have been posted
DRY_RUN=1
